# --- Database (SQLite file — nothing to sign up for) ---
DATABASE_URL=dev.db

# --- NextAuth ---
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:9002

# --- Genkit / Google AI (used by the AI flows in src/ai) ---
GOOGLE_GENAI_API_KEY=

# --- Paystack (wallet funding — get test keys from your Paystack dashboard) ---
PAYSTACK_SECRET_KEY=

# Development only: show verification links/codes on screen instead of emailing them. Never set on a real server.
EXPOSE_DEV_CODES=true

# ---------------------------------------------------------------------------
# Production only (set these as Fly.io secrets, never in a committed file)
# ---------------------------------------------------------------------------
# Cloudflare R2: photos, videos, ID documents and database backups.
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Resend (email): API key and a sender on a domain you verified in Resend.
# RESEND_API_KEY=
# EMAIL_FROM="Closebuy <no-reply@yourdomain.ng>"
# Termii (SMS): API key, approved sender ID, and the API address shown on your Termii dashboard.
# TERMII_API_KEY=
# TERMII_SENDER_ID=
# TERMII_BASE_URL=https://api.ng.termii.com
# TERMII_CHANNEL=dnd
# Show the built-in sample shops/products on the live site (normally leave unset).
# USE_SAMPLE_DATA=true
