{
  "name": "closebuy-mobile",
  "private": true,
  "version": "1.0.0",
  "description": "Closebuy for Android and iPhone: the Closebuy website (cbuyapp.com) inside a native app shell.",
  "scripts": {
    "assets": "capacitor-assets generate --android --ios --iconBackgroundColor '#ffffff' --iconBackgroundColorDark '#0b0f17' --splashBackgroundColor '#ffffff' --splashBackgroundColorDark '#0b0f17'",
    "sync": "cap sync",
    "android": "cap open android",
    "ios": "cap open ios",
    "build:android": "cap sync android && cd android && ./gradlew assembleDebug",
    "bundle:android": "cap sync android && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "8.6.0",
    "typescript": "^5.6.3"
  }
}
